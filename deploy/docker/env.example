# Copy to /volume1/docker/openhop-txmesh/txmesh.env and chmod 600 (deploy.sh does both).
# Everything specific to you lives here; the repo files stay generic.
# Write values without quotes. A "$" in a value must be written "$$".

# --- txme.sh login ---------------------------------------------------------
OPENHOP_TXMESH_USERNAME=YOUR-TXME-USERNAME
OPENHOP_TXMESH_PASSWORD=YOUR-TXME-PASSWORD

# --- This node -------------------------------------------------------------
# Must match the companion's node name in the repeater exactly.
OPENHOP_TXMESH_NODE_NAME=YOUR-NODE-NAME

# The openHop Repeater and the companion port created for this plugin.
OPENHOP_TXMESH_COMPANION_HOST=YOUR-REPEATER-IP
OPENHOP_TXMESH_COMPANION_PORT=5001

# --- Container networking --------------------------------------------------
# Name of an existing Docker network, and a free IP on it for this container.
TXMESH_NETWORK=YOUR-DOCKER-NETWORK
TXMESH_IP=YOUR-CONTAINER-IP

# Optional: timezone for log timestamps (default UTC).
TZ=UTC
